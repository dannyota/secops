# secopsctl environment overrides (copy to .env and fill in locally).
# .env is git-ignored. Use PLACEHOLDER values only in this example file.

# Path to your instance config (overrides the default search order).
# SECOPSCTL_CONFIG=./config/instance.yaml

# secopsctl user directory (default: ~/.secopsctl). Holds config (instance.yaml)
# and a cache/ dir for NON-secret data. No tokens are stored here — the OAuth
# access token is minted in-process from ADC by the Google auth library.
# SECOPSCTL_HOME=~/.secopsctl

# Force IPv4 dialing. Needed only on some corporate VPNs whose IPv6 routing to
# googleapis.com is broken. OFF by default. Set to 1/true/yes.
# SECOPS_FORCE_IPV4=0

# --- Auth (two independent mechanisms; configure only what you use) ----------

# OAuth / ADC — for the Chronicle SIEM API. Resolution order:
#   SECOPS_ACCESS_TOKEN  >  GOOGLE_APPLICATION_CREDENTIALS  >  gcloud ADC
# Provide a static OAuth2 bearer token (local .env only, never here):
# SECOPS_ACCESS_TOKEN=<your-oauth2-access-token>
# Or point at a service-account key JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# SOAR AppKey — for `secopsctl soar ...` (no ADC). Generate it in the Chronicle
# SOAR UI: Settings -> Advanced -> API Keys -> Add (long-lived, admin-scoped).
# Keep it in your local .env or a secret store; never commit it.
# SECOPS_SOAR_APP_KEY=PLACEHOLDER-SOAR-APPKEY
#
# SECOPS_API_KEY is a generic Google API key fallback; rarely needed (the SIEM
# API uses OAuth/ADC, not an API key).
# SECOPS_API_KEY=PLACEHOLDER-API-KEY
