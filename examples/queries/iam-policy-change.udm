# Cloud IAM policy changes
#
# Surfaces changes to IAM bindings / resource permissions (e.g. SetIamPolicy).
# Critical for detecting privilege escalation and unauthorized grants in cloud
# audit logs. The metadata.product_event_type filter is a generic example -
# adapt it to the operation name your cloud provider emits.
#
# Tenant-neutral: no real projects, users, domains, or IPs.
#
# Run with:
#   secopsctl query udm "$(cat examples/queries/iam-policy-change.udm)" --hours 72 --json

metadata.event_type = "USER_RESOURCE_UPDATE_PERMISSIONS"
AND metadata.product_event_type = "SetIamPolicy"
