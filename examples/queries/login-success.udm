# Successful user logins
#
# Surfaces interactive/authenticated sign-ins that succeeded.
# Useful as a baseline for "who logged in, from where" investigations.
#
# Tenant-neutral: no real users, domains, or IPs. Adjust the principal
# filter (e.g. principal.user.userid) to scope to a specific account.
#
# Run with:
#   secopstips query udm "$(cat examples/queries/login-success.udm)" --hours 24
#   secopstips query udm "$(cat examples/queries/login-success.udm)" --from 2026-01-01T00:00:00Z --to 2026-01-02T00:00:00Z --json

metadata.event_type = "USER_LOGIN"
AND security_result.action = "ALLOW"
