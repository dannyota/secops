# Go build artifacts
/secopsctl
/dist/
*.exe
*.test
*.out
*.prof

# Reference clones (read-only upstreams; never committed or imported)
/third_party/

# Secrets and credentials (NEVER commit)
.env
*.key
*.pem
service-account*.json

# Local tenant configuration (use config/instance.example.yaml as a template)
config/instance.yaml

# Pulled tenant content (local working data; do not commit tenant data)
rules/
reference_lists/
data_tables/
dashboards/
curated/
feeds/
parsers/

# OS / editor cruft
.DS_Store
*.swp

# Local-only tenant denylist for the leak guard (never commit)
/.githooks/denylist.local

# Persistent browser profile for local API/UI investigation (holds an authed
# session; never commit)
/.playwright-profile/

# Playwright MCP scratch (page snapshots / console logs may hold tenant data)
/.playwright-mcp/
