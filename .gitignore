# Go build artifacts
/secopsctl
/dist/
*.exe
*.test
*.out
*.prof

# Reference clones (read-only upstreams; never committed or imported)
/third_party/

# Secrets and credentials (NEVER commit)
.env
*.key
*.pem
service-account*.json

# Local tenant configuration (use config/instance.example.yaml as a template)
config/instance.yaml

# OS / editor cruft
.DS_Store
*.swp

# Local-only tenant denylist for the leak guard (never commit)
/.githooks/denylist.local

# Persistent browser profile (holds an authed session; never commit)
/.playwright-profile/

# Playwright MCP scratch (page snapshots / console logs)
/.playwright-mcp/

# Project-local MCP config (references local paths / browser profile)
/.mcp.json

samples/

# Local-only working build plan
/plan.md
